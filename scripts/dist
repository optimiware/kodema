#!/usr/bin/env bash
# scripts/dist: build the release artifacts of this checkout. Nothing is pushed.
#
#   scripts/dist [--output <directory>] [--version <version>]
#
# For the version in the VERSION file (or --version, used by automatic patch
# releases without touching the checkout) it writes, into dist/ by default:
#
#   kodema_<version>_<os>_<arch>.tar.gz    kodema and LICENSE, one per platform
#   kodema-<version>.tgz                   the control-plane Helm chart
#   kodema-stack-<version>.tgz             the stack Helm chart (bundles kodema)
#   SHA256SUMS                             digests of every file above
#
# DIST_PLATFORMS overrides the platforms (space-separated os/arch). install.sh
# installs the archive of a platform. The container image is built by
# scripts/image, not here.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

die() { printf 'scripts/dist: %s\n' "$*" >&2; exit 1; }

output="${repo_root}/dist"
version=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --output) [[ $# -ge 2 ]] || die "--output requires a value"; output="$2"; shift 2 ;;
    --version) [[ $# -ge 2 ]] || die "--version requires a value"; version="$2"; shift 2 ;;
    -h|--help) sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

for tool in go helm git tar sha256sum; do
  command -v "$tool" >/dev/null 2>&1 || die "${tool} is required"
done

base_version="$(<"${repo_root}/VERSION")"
[[ "$base_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || die "VERSION '${base_version}' is not MAJOR.MINOR.PATCH"
[[ -n "$version" ]] || version="$base_version"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || die "version '${version}' is not MAJOR.MINOR.PATCH"
if [[ "$version" != "$base_version" ]]; then
  command -v perl >/dev/null 2>&1 || die "perl is required when --version differs from VERSION"
fi
revision="$(git -C "$repo_root" rev-parse HEAD)"
# Archive entries carry the commit time, so the same commit gives the same bytes.
commit_time="$(git -C "$repo_root" log -1 --format=%ct HEAD)"
platforms="${DIST_PLATFORMS:-linux/amd64 linux/arm64 darwin/amd64 darwin/arm64}"

# helm package takes the chart version from Chart.yaml; refuse a checkout whose
# charts disagree with VERSION instead of publishing inconsistent versions.
for chart in kodema kodema-stack; do
  chart_version="$(sed -n 's/^version: *//p' "${repo_root}/deploy/charts/${chart}/Chart.yaml")"
  [[ "$chart_version" == "$base_version" ]] || die "chart ${chart} is version '${chart_version}', VERSION is '${base_version}'"
done

replace() {
  local file=$1 from=$2 to=$3
  grep -qF -- "$from" "$file" || die "${file} does not contain '${from}'"
  FROM="$from" TO="$to" perl -0pi -e 's/\Q$ENV{FROM}\E/$ENV{TO}/g' "$file"
}

mkdir -p "$output"
output="$(cd "$output" && pwd)"
[[ -z "$(ls -A "$output")" ]] || die "${output} is not empty; remove it first"
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT

for platform in $platforms; do
  os="${platform%/*}"
  arch="${platform#*/}"
  name="kodema_${version}_${os}_${arch}"
  mkdir "${stage}/${name}"
  (cd "$repo_root" && CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" \
    go build -trimpath -buildvcs=false \
      -ldflags "-s -w -X main.version=${version} -X main.revision=${revision}" \
      -o "${stage}/${name}/kodema" ./cmd/kodema)
  cp "${repo_root}/LICENSE" "${stage}/${name}/LICENSE"
  tar -C "$stage" --sort=name --owner=0 --group=0 --numeric-owner --mtime="@${commit_time}" \
    -cf - "$name" | gzip -n >"${output}/${name}.tar.gz"
done

# The stack chart's dependency is file://../kodema. Package a copy, so the
# vendored subchart and any --version override never land in the checkout.
cp -R "${repo_root}/deploy/charts" "${stage}/charts"
if [[ "$version" != "$base_version" ]]; then
  for chart in kodema kodema-stack; do
    replace "${stage}/charts/${chart}/Chart.yaml" "version: ${base_version}"$'\n' "version: ${version}"$'\n'
    replace "${stage}/charts/${chart}/Chart.yaml" "appVersion: \"${base_version}\"" "appVersion: \"${version}\""
    replace "${stage}/charts/${chart}/values.yaml" "tag: \"${base_version}\"" "tag: \"${version}\""
  done
  replace "${stage}/charts/kodema-stack/Chart.yaml" "    version: \"${base_version}\"" "    version: \"${version}\""
fi
helm package "${stage}/charts/kodema" --destination "$output" >/dev/null
helm package --dependency-update "${stage}/charts/kodema-stack" --destination "$output" >/dev/null

(cd "$output" && sha256sum -- * >SHA256SUMS)
printf 'scripts/dist: version %s, revision %s\n' "$version" "$revision"
(cd "$output" && ls -1)
